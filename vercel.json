{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/card/:slug", "destination": "/card/:slug.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*).vcf",
      "headers": [
        { "key": "Content-Type", "value": "text/vcard; charset=utf-8" }
      ]
    }
  ]
}
